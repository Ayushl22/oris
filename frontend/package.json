{
  "name": "wind-window",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "typecheck": "tsc -b",
    "format:check": "prettier --check src *.json *.ts *.html tests",
    "format": "prettier --write src *.json *.ts *.html tests"
  },
  "dependencies": {
    "lucide-react": "0.552.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "3.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.56.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm ci --prefix frontend && npm run build --prefix frontend && python scripts/prepare_vercel.py",
  "functions": {
    "app.py": {
      "maxDuration": 30,
      "includeFiles": "{data/snapshot.json.gz,frontend/dist/**}",
      "excludeFiles": "{.venv/**,.git/**,.ruff_cache/**,**/__pycache__/**,**/.pytest_cache/**,**/node_modules/**,frontend/src/**,frontend/tests/**,public/**,docs/**,scripts/**,backend/tests/**,backend/.test-tmp/**,**/*.tsbuildinfo,**/test-results/**,**/playwright-report/**}"
    }
  }
}

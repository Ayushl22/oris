# Backend. Defaults work with the included immutable historical snapshot.
DEFAULT_CUTOFF=10:00
# DATA_PATH is a LOCAL-only override. Vercel always reads its bundled snapshot.
# DATA_PATH=/absolute/path/to/snapshot.json.gz
# Comma-separated frontend origins, only needed when serving separately.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000
# Compose host port; use 8001 when a local API already occupies 8000.
APP_PORT=8000
# Vercel hosts frontend and API together: leave VITE_API_BASE_URL unset.
# VERCEL is automatically supplied by Vercel, not a user setting.

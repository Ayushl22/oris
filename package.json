{
  "name": "wind-window-deployment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "build": "npm ci --prefix frontend && npm run build --prefix frontend && python scripts/prepare_vercel.py",
    "verify:routing": "node scripts/verify_vercel.mjs",
    "verify:deployed": "node scripts/verify_deployment.mjs"
  },
  "devDependencies": {
    "@vercel/routing-utils": "6.6.0",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "ajv-formats": "3.0.1"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  }
}
